# ========================================
# VARIÁVEIS DE AMBIENTE PARA VERCEL
# ========================================

# 1. DATABASE_URL
# Cole aqui a connection string do seu banco PostgreSQL
# Exemplo Neon: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb
DATABASE_URL="postgresql://..."

# 2. NEXTAUTH_URL
# URL do seu site na Vercel (será gerada após deploy)
# Temporário: pode usar qualquer URL, depois atualizar
NEXTAUTH_URL="https://seu-app.vercel.app"

# 3. NEXTAUTH_SECRET
# Gere um secret seguro (32+ caracteres aleatórios)
# Execute: openssl rand -base64 32
NEXTAUTH_SECRET="cole-aqui-o-secret-gerado"

# 4. GOOGLE OAuth (OPCIONAL - pode adicionar depois)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 5. ADMIN_EMAILS
# Lista de emails de administradores separados por vírgula
# Estes usuários terão acesso ao painel administrativo
ADMIN_EMAILS="seu-email@example.com,outro-admin@example.com"

# ========================================
# INSTRUÇÕES:
# 1. Preencha as variáveis acima
# 2. Cole na Vercel durante o deploy
# 3. NÃO comite este arquivo!
# ========================================
