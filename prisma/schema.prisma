// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// AUTHENTICATION & USER MODELS
// ============================================================================

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  password           String? // Null for OAuth users
  provider           String    @default("credentials") // "credentials" | "google"
  emailVerified      DateTime? @map("email_verified")
  image              String?
  resetToken         String?   @unique @map("reset_token")
  resetTokenExpiry   DateTime? @map("reset_token_expiry")
  approved           Boolean   @default(false) // User approved to access the app
  isSystemUser       Boolean   @default(false) @map("is_system_user") // Ocultar de queries públicas
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Relations
  profile        Profile?
  gameSessions   GameSession[]
  userCards      UserCard[]
  cardLikes      CardLike[]
  notifications  Notification[]
  postComments   PostComment[]

  @@map("users")
}

// Waitlist for beta testers
model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  status    String   @default("pending") // "pending" | "approved" | "rejected"
  notes     String? // Admin notes
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("waitlist")
}

model Profile {
  id          String  @id @default(cuid())
  userId      String  @unique @map("user_id")
  nickname    String  @unique
  bio         String?
  orientation String? // "heterosexual" | "homosexual" | "bisexual" | "other"
  sex         String? // "male" | "female"

  // Delivery address fields
  deliveryAddress    String? @map("delivery_address")
  deliveryCity       String? @map("delivery_city")
  deliveryState      String? @map("delivery_state")
  deliveryZipCode    String? @map("delivery_zip_code")
  deliveryComplement String? @map("delivery_complement")

  // Social/stats fields
  sessionsPlayed Int      @default(0) @map("sessions_played")
  averageRating  Float?   @map("average_rating")
  lastActiveAt   DateTime @default(now()) @map("last_active_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionsFrom     Connection[]         @relation("ConnectionFrom")
  connectionsTo       Connection[]         @relation("ConnectionTo")
  sessionParticipants SessionParticipant[]
  onlineAnswers       OnlineAnswer[]
  invitationsSent     SessionInvitation[]  @relation("InvitationSender")
  invitationsReceived SessionInvitation[]  @relation("InvitationReceiver")
  ratingsGiven        UserRating[]         @relation("RatingFrom")
  ratingsReceived     UserRating[]         @relation("RatingTo")
  messagesSent        DirectMessage[]      @relation("MessagesSent")
  messagesReceived    DirectMessage[]      @relation("MessagesReceived")
  posts               Post[]
  postLikes           PostLike[]

  // Marketplace relations
  cartItems     CartItem[]
  ordersAsBuyer Order[]

  @@map("profiles")
}

// ============================================================================
// SOCIAL NETWORK MODELS
// ============================================================================

model Connection {
  id        String   @id @default(cuid())
  fromId    String   @map("from_id")
  toId      String   @map("to_id")
  status    String   @default("pending") // "pending" | "accepted" | "rejected"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  from Profile @relation("ConnectionFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Profile @relation("ConnectionTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@map("connections")
}

// User ratings - avaliações entre usuários após sessões
model UserRating {
  id        String   @id @default(cuid())
  fromId    String   @map("from_id") // Quem avaliou
  toId      String   @map("to_id") // Quem foi avaliado
  sessionId String?  @map("session_id") // Sessão onde jogaram juntos (opcional)
  rating    Int // 1-5 estrelas
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  from Profile @relation("RatingFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Profile @relation("RatingTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, sessionId]) // Uma avaliação por sessão
  @@map("user_ratings")
}

// Session invitations - convites para sessões
model SessionInvitation {
  id        String   @id @default(cuid())
  senderId  String   @map("sender_id") // Quem enviou o convite
  receiverId String  @map("receiver_id") // Quem recebeu
  sessionId String?  @map("session_id") // Sessão para qual foi convidado (pode ser null se ainda não criada)
  sessionType String @map("session_type") // "casal" | "trisal" | "grupo"
  status    String   @default("pending") // "pending" | "accepted" | "rejected" | "cancelled"
  message   String?  @db.Text // Mensagem personalizada do convite
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  sender   Profile @relation("InvitationSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver Profile @relation("InvitationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@map("session_invitations")
}

// Posts - publicações estilo rede social (tipo X/Twitter)
model Post {
  id        String   @id @default(cuid())
  profileId String   @map("profile_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  profile  Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  likes    PostLike[]
  comments PostComment[]

  @@map("posts")
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("post_comments")
}

// Notifications - sistema de notificações
model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String   // "connection_request" | "connection_accepted" | "session_invitation" | "post_comment" | "post_like"
  message   String
  read      Boolean  @default(false)
  data      Json?    // Extra data (e.g., fromNickname, postId)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  profileId String   @map("profile_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([postId, profileId])
  @@map("post_likes")
}

// Direct messages - mensagens diretas únicas para usuários sem conexão
model DirectMessage {
  id         String   @id @default(cuid())
  senderId   String   @map("sender_id")
  receiverId String   @map("receiver_id")
  message    String   @db.Text
  read       Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  sender   Profile @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiver Profile @relation("MessagesReceived", fields: [receiverId], references: [id], onDelete: Cascade)

  @@map("direct_messages")
}

// ============================================================================
// CARD MODELS
// ============================================================================

model Card {
  id         String   @id @default(cuid())
  type       String // "pergunta" | "tarefa"
  category   String // "casais" | "trios" | "grupos"
  difficulty String // "facil" | "medio" | "dificil" | "extremo"
  content    String   @db.Text
  isOfficial Boolean  @default(true) @map("is_official")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  playedCards  PlayedCard[]
  cardLikes    CardLike[]
  onlineRounds OnlineRound[]

  @@map("cards")
}

model UserCard {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  type       String // "pergunta" | "tarefa"
  category   String // "casais" | "trios" | "grupos"
  difficulty String // "facil" | "medio" | "dificil" | "extremo"
  content    String   @db.Text
  approved   Boolean  @default(false)
  likesCount Int      @default(0) @map("likes_count")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardLikes CardLike[]

  @@map("user_cards")
}

model CardLike {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  cardId     String?  @map("card_id")
  userCardId String?  @map("user_card_id")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  card     Card?     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userCard UserCard? @relation(fields: [userCardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@unique([userId, userCardId])
  @@map("card_likes")
}

// ============================================================================
// GAME SESSION MODELS
// ============================================================================

model GameSession {
  id                   String    @id @default(cuid())
  creatorId            String    @map("creator_id")
  sessionType          String    @map("session_type") // "casal" | "trisal" | "grupo" (determined by participant count)
  mode                 String    @default("local") // "local" | "online"
  status               String    @default("active") // "active" | "finished"
  currentTurnProfileId String?   @map("current_turn_profile_id") // Profile ID of who is picking the card (local mode only)
  currentRoundId       String?   @map("current_round_id") // Current round ID (online mode only)
  averageRating        Float?    @map("average_rating")
  cardsPlayed          Int       @default(0) @map("cards_played")
  skipsUsed            Int       @default(0) @map("skips_used")
  maxSkips             Int       @default(3) @map("max_skips")
  createdAt            DateTime  @default(now()) @map("created_at")
  finishedAt           DateTime? @map("finished_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  // Relations
  creator             User                 @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  sessionParticipants SessionParticipant[]
  playedCards         PlayedCard[]
  onlineRounds        OnlineRound[]

  @@map("game_sessions")
}

model SessionParticipant {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  profileId String   @map("profile_id")
  joinedAt  DateTime @default(now()) @map("joined_at")

  // Relations
  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  profile Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([sessionId, profileId])
  @@map("session_participants")
}

model PlayedCard {
  id                  String   @id @default(cuid())
  sessionId           String   @map("session_id")
  cardId              String   @map("card_id")
  pickedByProfileId   String   @map("picked_by_profile_id") // Who picked/drew the card
  answeredByProfileId String?  @map("answered_by_profile_id") // Who answered/executed
  qualitativeRating   String?  @map("qualitative_rating") // "ruim" | "satisfatoria" | "excelente"
  rating              Int? // Legacy numeric rating (0-5 stars) - kept for compatibility
  playedAt            DateTime @default(now()) @map("played_at")

  // Relations
  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  card    Card        @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@map("played_cards")
}

// Online Mode - Each card in online mode is a "round" where all players must answer
model OnlineRound {
  id                   String    @id @default(cuid())
  sessionId            String    @map("session_id")
  cardId               String    @map("card_id")
  roundNumber          Int       @map("round_number")
  currentTurnProfileId String    @map("current_turn_profile_id") // Profile ID que vira a carta e responde primeiro
  status               String    @default("waiting") // "waiting" | "completed"
  startedAt            DateTime  @default(now()) @map("started_at")
  completedAt          DateTime? @map("completed_at")

  // Relations
  session GameSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  card    Card           @relation(fields: [cardId], references: [id], onDelete: Cascade)
  answers OnlineAnswer[]

  @@map("online_rounds")
}

// Each player's answer in an online round
model OnlineAnswer {
  id         String   @id @default(cuid())
  roundId    String   @map("round_id")
  profileId  String   @map("profile_id")
  answer     String   @db.Text
  answeredAt DateTime @default(now()) @map("answered_at")

  // Relations
  round   OnlineRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  profile Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([roundId, profileId]) // One answer per player per round
  @@map("online_answers")
}

// ============================================================================
// MARKETPLACE MODELS - LOJA PIMENTINHAS
// ============================================================================

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  subcategories Subcategory[]

  @@map("categories")
}

model Subcategory {
  id          String   @id @default(cuid())
  categoryId  String   @map("category_id")
  name        String
  slug        String
  description String?  @db.Text
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  category Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([categoryId, slug])
  @@map("subcategories")
}

model Product {
  id            String   @id @default(cuid())
  subcategoryId String   @map("subcategory_id")
  name          String
  description   String   @db.Text
  price         Decimal  @db.Decimal(10, 2)
  stock         Int      @default(0)
  images        Json     @default("[]") // Array de URLs ou base64
  active        Boolean  @default(true)
  featured      Boolean  @default(false) // Produto em destaque
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  subcategory Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@map("products")
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user    Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("cart_items")
}

model Order {
  id          String  @id @default(cuid())
  buyerId     String  @map("buyer_id")
  totalAmount Decimal @map("total_amount") @db.Decimal(10, 2)
  status      String  @default("pending") // "pending" | "paid_awaiting_confirmation" | "confirmed" | "shipped" | "delivered" | "cancelled"

  // Delivery address (snapshot from buyer's profile at order time)
  deliveryAddress    String  @map("delivery_address")
  deliveryCity       String  @map("delivery_city")
  deliveryState      String  @map("delivery_state")
  deliveryZipCode    String  @map("delivery_zip_code")
  deliveryComplement String? @map("delivery_complement")

  paymentProof           String?   @map("payment_proof") @db.Text // Imagem base64 do comprovante
  paymentProofUploadedAt DateTime? @map("payment_proof_uploaded_at")
  confirmedAt            DateTime? @map("confirmed_at")
  shippedAt              DateTime? @map("shipped_at")
  deliveredAt            DateTime? @map("delivered_at")
  cancelledAt            DateTime? @map("cancelled_at")
  cancellationReason     String?   @map("cancellation_reason") @db.Text
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  // Relations
  buyer      Profile     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("orders")
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String  @map("order_id")
  productId    String  @map("product_id")
  productName  String  @map("product_name") // Snapshot do nome
  productPrice Decimal @map("product_price") @db.Decimal(10, 2) // Snapshot do preço
  quantity     Int
  subtotal     Decimal @db.Decimal(10, 2)

  // Relations
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("order_items")
}
