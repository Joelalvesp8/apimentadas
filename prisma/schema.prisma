// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// AUTHENTICATION & USER MODELS
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  password      String?   // Null for OAuth users
  provider      String    @default("credentials") // "credentials" | "google"
  emailVerified DateTime? @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  profile       Profile?
  gameSessions  GameSession[]
  userCards     UserCard[]
  cardLikes     CardLike[]

  @@map("users")
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
  nickname    String   @unique
  bio         String?
  orientation String?  // "heterosexual" | "homosexual" | "bisexual" | "other"

  // Marketplace - Seller fields
  isVendor        Boolean @default(false) @map("is_vendor")
  pixKey          String? @map("pix_key")
  storeName       String? @map("store_name")
  storeDescription String? @map("store_description") @db.Text

  // Delivery address fields
  deliveryAddress    String? @map("delivery_address")
  deliveryCity       String? @map("delivery_city")
  deliveryState      String? @map("delivery_state")
  deliveryZipCode    String? @map("delivery_zip_code")
  deliveryComplement String? @map("delivery_complement")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionsFrom       Connection[]          @relation("ConnectionFrom")
  connectionsTo         Connection[]          @relation("ConnectionTo")
  sessionParticipants   SessionParticipant[]

  // Marketplace relations
  products              Product[]
  cartItems             CartItem[]
  ordersAsBuyer         Order[]               @relation("BuyerOrders")
  ordersAsSeller        Order[]               @relation("SellerOrders")

  @@map("profiles")
}

// ============================================================================
// SOCIAL NETWORK MODELS
// ============================================================================

model Connection {
  id        String   @id @default(cuid())
  fromId    String   @map("from_id")
  toId      String   @map("to_id")
  status    String   @default("pending") // "pending" | "accepted" | "rejected"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  from Profile @relation("ConnectionFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Profile @relation("ConnectionTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@map("connections")
}

// ============================================================================
// CARD MODELS
// ============================================================================

model Card {
  id          String   @id @default(cuid())
  type        String   // "pergunta" | "tarefa"
  category    String   // "casais" | "trios" | "grupos"
  difficulty  String   // "facil" | "medio" | "dificil" | "extremo"
  content     String   @db.Text
  isOfficial  Boolean  @default(true) @map("is_official")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  playedCards PlayedCard[]
  cardLikes   CardLike[]

  @@map("cards")
}

model UserCard {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  type        String   // "pergunta" | "tarefa"
  category    String   // "casais" | "trios" | "grupos"
  difficulty  String   // "facil" | "medio" | "dificil" | "extremo"
  content     String   @db.Text
  approved    Boolean  @default(false)
  likesCount  Int      @default(0) @map("likes_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardLikes CardLike[]

  @@map("user_cards")
}

model CardLike {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  cardId     String?  @map("card_id")
  userCardId String?  @map("user_card_id")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  card     Card?     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userCard UserCard? @relation(fields: [userCardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@unique([userId, userCardId])
  @@map("card_likes")
}

// ============================================================================
// GAME SESSION MODELS
// ============================================================================

model GameSession {
  id                  String    @id @default(cuid())
  creatorId           String    @map("creator_id")
  sessionType         String    @map("session_type") // "casal" | "trisal" | "grupo" (determined by participant count)
  status              String    @default("active") // "active" | "finished"
  currentTurnProfileId String?  @map("current_turn_profile_id") // Profile ID of who is picking the card
  averageRating       Float?    @map("average_rating")
  cardsPlayed         Int       @default(0) @map("cards_played")
  createdAt           DateTime  @default(now()) @map("created_at")
  finishedAt          DateTime? @map("finished_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  // Relations
  creator             User                  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  sessionParticipants SessionParticipant[]
  playedCards         PlayedCard[]

  @@map("game_sessions")
}

model SessionParticipant {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  profileId String   @map("profile_id")
  joinedAt  DateTime @default(now()) @map("joined_at")

  // Relations
  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  profile Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([sessionId, profileId])
  @@map("session_participants")
}

model PlayedCard {
  id                  String   @id @default(cuid())
  sessionId           String   @map("session_id")
  cardId              String   @map("card_id")
  pickedByProfileId   String   @map("picked_by_profile_id") // Who picked/drew the card
  answeredByProfileId String?  @map("answered_by_profile_id") // Who answered/executed
  qualitativeRating   String?  @map("qualitative_rating") // "ruim" | "satisfatoria" | "excelente"
  rating              Int?     // Legacy numeric rating (0-5 stars) - kept for compatibility
  playedAt            DateTime @default(now()) @map("played_at")

  // Relations
  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  card    Card        @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@map("played_cards")
}

// ============================================================================
// MARKETPLACE MODELS
// ============================================================================

model Product {
  id          String   @id @default(cuid())
  sellerId    String   @map("seller_id")
  name        String
  description String   @db.Text
  price       Decimal  @db.Decimal(10, 2)
  category    String   // "vibradores" | "lingerie" | "acessorios" | "lubrificantes" | "fantasias" | "outros"
  stock       Int      @default(0)
  images      Json     @default("[]") // Array de URLs ou base64
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  seller      Profile      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@map("products")
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user    Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("cart_items")
}

model Order {
  id                      String    @id @default(cuid())
  buyerId                 String    @map("buyer_id")
  sellerId                String    @map("seller_id")
  totalAmount             Decimal   @db.Decimal(10, 2) @map("total_amount")
  status                  String    @default("pending") // "pending" | "paid_awaiting_confirmation" | "confirmed" | "shipped" | "delivered" | "cancelled"
  pixKey                  String    @map("pix_key") // Snapshot da chave PIX do vendedor

  // Delivery address (snapshot from buyer's profile at order time)
  deliveryAddress         String    @map("delivery_address")
  deliveryCity            String    @map("delivery_city")
  deliveryState           String    @map("delivery_state")
  deliveryZipCode         String    @map("delivery_zip_code")
  deliveryComplement      String?   @map("delivery_complement")

  paymentProof            String?   @map("payment_proof") @db.Text // Imagem base64 do comprovante
  paymentProofUploadedAt  DateTime? @map("payment_proof_uploaded_at")
  confirmedAt             DateTime? @map("confirmed_at")
  shippedAt               DateTime? @map("shipped_at")
  deliveredAt             DateTime? @map("delivered_at")
  cancelledAt             DateTime? @map("cancelled_at")
  cancellationReason      String?   @map("cancellation_reason") @db.Text
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  // Relations
  buyer      Profile     @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  seller     Profile     @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("orders")
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String  @map("order_id")
  productId    String  @map("product_id")
  productName  String  @map("product_name") // Snapshot do nome
  productPrice Decimal @db.Decimal(10, 2) @map("product_price") // Snapshot do preço
  quantity     Int
  subtotal     Decimal @db.Decimal(10, 2)

  // Relations
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("order_items")
}
