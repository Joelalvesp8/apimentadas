# ==============================================================================
# ARQUIVO .env.local - PARA DESENVOLVIMENTO LOCAL
# ==============================================================================
#
# INSTRUÇÕES:
# 1. Copie este arquivo para .env.local
# 2. Preencha os valores reais
# 3. NUNCA commite .env.local (já está no .gitignore)
#
# ==============================================================================

# DATABASE_URL - Copie do Supabase
# 1. Acesse: https://supabase.com/dashboard
# 2. Selecione seu projeto
# 3. Vá em Settings → Database
# 4. Em "Connection String", copie a URI mode
# 5. Cole aqui (substitua [YOUR-PASSWORD] pela senha real)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# NEXTAUTH_URL - URL local
NEXTAUTH_URL="http://localhost:3000"

# NEXTAUTH_SECRET - Gere um secret aleatório
# Execute: openssl rand -base64 32
NEXTAUTH_SECRET="cole-aqui-o-secret-gerado"

# RESEND_API_KEY - Para testar emails localmente
# Pegue em: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ADMIN_EMAILS
ADMIN_EMAILS="seu-email@example.com"

# ==============================================================================
# OPCIONAL - OAuth Google
# ==============================================================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
